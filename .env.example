# Copy to .env.local and fill in. Never commit real values.

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Postgres) ───────────────────────────────
# Local: `npm run db:up` starts this one in Docker.
# Production: Neon / Supabase / Vercel Postgres connection string (with ?sslmode=require).
DATABASE_URL=postgresql://jupeang:jupeang@localhost:5432/jupeang

# ── Auth.js ───────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Optional Google sign-in. Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Stripe ────────────────────────────────────────────
# Leave empty to take "order requests" without online payment.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally,
# or the webhook endpoint in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=
# Set to true once Stripe is configured (changes checkout wording).
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ── Sanity ────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ── Email (Resend) ────────────────────────────────────
RESEND_API_KEY=
OWNER_EMAIL=
EMAIL_FROM=
